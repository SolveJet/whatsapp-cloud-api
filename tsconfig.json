{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Silences TS5101 for `baseUrl`, which tsup (8.5.1) injects into the
    // compiler options during its DTS build (our own typecheck never sets it).
    // Remove once tsup stops injecting baseUrl or on the TypeScript 7 upgrade.
    "ignoreDeprecations": "6.0",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "*.config.ts", "eslint.config.mjs"]
}
