{
  "name": "@solvejet/whatsapp-cloud-api",
  "version": "1.2.1",
  "description": "TypeScript SDK for the WhatsApp Cloud API (Meta WhatsApp Business Platform). Send WhatsApp messages, media, templates, and interactive messages, verify and parse webhooks, and manage phone numbers, WhatsApp Business Accounts (WABA), and message templates. Zero runtime dependencies, built on native fetch for Node.js 20+.",
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "whatsapp-sdk",
    "whatsapp-cloud-api",
    "whatsapp-business",
    "whatsapp-business-api",
    "whatsapp-business-platform",
    "whatsapp-webhooks",
    "whatsapp-templates",
    "send-whatsapp-message",
    "cloud-api",
    "meta",
    "graph-api",
    "business-messaging",
    "messaging",
    "chatbot",
    "sdk",
    "typescript",
    "typescript-sdk",
    "nodejs"
  ],
  "homepage": "https://github.com/SolveJet/whatsapp-cloud-api#readme",
  "bugs": {
    "url": "https://github.com/SolveJet/whatsapp-cloud-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolveJet/whatsapp-cloud-api.git"
  },
  "license": "MIT",
  "author": "SolveJet",
  "contributors": [
    "SolveJet (https://github.com/SolveJet)"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.0"
  }
}
