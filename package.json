{
  "name": "@solvejet/whatsapp-cloud-api",
  "version": "1.3.0",
  "description": "Zero-dependency TypeScript SDK for the WhatsApp Cloud API: send messages, templates and media, verify webhooks, manage WABAs. Node 20+, native fetch.",
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "whatsapp-sdk",
    "whatsapp-cloud-api",
    "whatsapp-business",
    "whatsapp-business-api",
    "whatsapp-business-platform",
    "whatsapp-webhooks",
    "whatsapp-templates",
    "whatsapp-flows",
    "bsuid",
    "send-whatsapp-message",
    "cloud-api",
    "meta",
    "graph-api",
    "business-messaging",
    "messaging",
    "chatbot",
    "sdk",
    "typescript",
    "typescript-sdk",
    "nodejs"
  ],
  "homepage": "https://github.com/SolveJet/whatsapp-cloud-api#readme",
  "bugs": {
    "url": "https://github.com/SolveJet/whatsapp-cloud-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolveJet/whatsapp-cloud-api.git"
  },
  "license": "MIT",
  "author": "SolveJet",
  "contributors": [
    "SolveJet (https://github.com/SolveJet)"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
